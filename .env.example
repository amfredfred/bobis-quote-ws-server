LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://...

# Supabase Auth
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_JWKS_URI=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=   # fallback HS256 (optional — prefer JWKS)
SUPABASE_SERVICE_ROLE_KEY=   # required for SupabaseGuard server-side token verification

# MetaApi
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# Signal Engine
SIGNAL_ENGINE_WS_URL=ws://localhost:8765
SIGNAL_ENGINE_SYMBOLS=JP225,GBPNZD,NZDCHF,AUDUSD,AUDCHF,XRPUSD,NZDCAD,EURUSD,ETHUSD,EURJPY,USDCAD,USDJPY,AUDCAD,SOLUSD,XAUUSD

# Firebase (JSON string of service account)
FIREBASE_SERVICE_ACCOUNT=

# Anthropic AI
ANTHROPIC_API_KEY=

# RevenueCat
REVENUECAT_SECRET_KEY=

# Server
PORT=3000
CORS_ORIGIN=https://your-app-domain.com
