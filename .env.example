LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://...

# Supabase Auth
SUPABASE_JWKS_URI=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=   # fallback HS256 (optional)

# MetaApi
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# Signal Engine
SIGNAL_ENGINE_WS_URL=ws://localhost:8765
SIGNAL_ENGINE_SYMBOLS=EURUSD,XAUUSD,GBPUSD

# Firebase (JSON string of service account)
FIREBASE_SERVICE_ACCOUNT=

# Anthropic AI
ANTHROPIC_API_KEY=

# RevenueCat
REVENUECAT_SECRET_KEY=

# Server
PORT=3000
CORS_ORIGIN=*
