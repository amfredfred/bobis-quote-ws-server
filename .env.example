LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://...

# Supabase Auth
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_JWKS_URI=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=   # fallback HS256 (optional — prefer JWKS)
SUPABASE_SERVICE_ROLE_KEY=   # required for SupabaseGuard server-side token verification

# MetaApi
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# Signal Engine
SIGNAL_ENGINE_WS_URL=ws://localhost:8765
# Symbols are no longer configured here — the engine subscribes dynamically
# based on what users have signed up for in UserSignalSubscription.

# Anthropic AI
ANTHROPIC_API_KEY=

# RevenueCat
REVENUECAT_API_KEY=

# Server
PORT=3000
CORS_ORIGIN=https://your-app-domain.com
