DATABASE_URL=
DIRECT_URL=
# If the database password contains reserved URL characters like @, #, ?, or /,
# URL-encode them in DATABASE_URL and DIRECT_URL.

# Supabase Auth
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_JWKS_URI=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=   # fallback HS256 (optional — prefer JWKS)
SUPABASE_SERVICE_ROLE_KEY=   # required for SupabaseGuard server-side token verification

# Symbols are no longer configured here — the engine subscribes dynamically

# RevenueCat
REVENUECAT_API_KEY=
REVENUECAT_SECRET_KEY=   # server-side secret for subscriber lookups
REVENUECAT_PROJECT_ID=
REVENUECAT_WEBHOOK_SECRET=

# Server
PORT=3000
CORS_ORIGIN=https://your-app-domain.com
LOG_LEVEL=debug
