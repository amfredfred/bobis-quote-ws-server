  from_tier       String?  @db.VarChar(20)
  to_tier         String   @db.VarChar(20)
  confirmed_count Int
  achieved_at     DateTime @default(now()) @db.Timestamptz(6)
  profiles        Profile  @relation(fields: [user_id], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, achieved_at(sort: Desc)], map: "rme_user_idx")
