generator client {
  provider     = "prisma-client"
  output       = "../src/prisma/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model Profile {
  userId                    String                      @id @map("user_id") @db.Uuid
  username                  String?                     @unique
  displayName               String?                     @map("display_name")
  avatarUrl                 String?                     @map("avatar_url")
  notificationPushToken     String?                     @map("notification_push_token")
  pushEnabled               Boolean                     @default(true) @map("push_enabled")
  strategyReminders         Boolean                     @default(true) @map("strategy_reminders")
  accountAlerts             Boolean                     @default(true) @map("account_alerts")
  sessionReminders          Boolean                     @default(true) @map("session_reminders")
  drawdownWarnings          Boolean                     @default(true) @map("drawdown_warnings")
  profitTargetAlerts        Boolean                     @default(false) @map("profit_target_alerts")
  signalAlertsEnabled       Boolean                     @default(false) @map("signal_alerts_enabled")
  maxTradesWarnings         Boolean                     @default(true) @map("max_trades_warnings")
  tradingDaysReminders      Boolean                     @default(true) @map("trading_days_reminders")
  lastNotificationSentAt    DateTime?                   @map("last_notification_sent_at") @db.Timestamptz(6)
  notificationSentToday     Int                         @default(0) @map("notification_sent_today")
  lastNotificationReset     DateTime?                   @map("last_notification_reset") @db.Timestamptz(6)
  proExpiresAt              DateTime?                   @map("pro_expires_at") @db.Timestamptz(6)
  revenuecatAppUserId       String?                     @map("revenuecat_app_user_id")
  subscriptionStatus        SubscriptionStatus?         @map("subscription_status")
  timezone                  String                      @default("America/New_York")
  createdAt                 DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime?                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  subscriptionTier          String?                     @map("subscription_tier")
  journalTrades             JournalTrade[]
  notificationLogs          NotificationLog[]
  referralLink              ReferralLink?
  referral_milestone_events referral_milestone_events[]
  referralRewards           ReferralReward[]
  referralsReceived         Referral[]                  @relation("RefereeReferrals")
  referralsGiven            Referral[]                  @relation("ReferrerReferrals")
  tradingAccounts           TradingAccount[]
  tradingAnalytics          TradingAnalytics[]
  tradingStrategies         TradingStrategy[]
  signalSubscriptions       UserSignalSubscription[]

  @@map("profiles")
  @@schema("public")
}

model TradingAccount {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @map("user_id") @db.Uuid
  accountType            JournalAccountType @default(personal) @map("account_type")
  name                   String
  accountNumber          String             @unique @map("account_number")
  currency               String             @default("usd")
  startBalance           Float              @map("start_balance")
  currentBalance         Float?             @map("current_balance")
  platform               BrokerPlatform?
  metaApiAccountId       String?            @unique @map("meta_api_account_id")
  autoTradeEnabled       Boolean            @default(false) @map("auto_trade_enabled")
  riskConfig             Json?              @map("risk_config")
  lastSyncAt             DateTime?          @map("last_sync_at") @db.Timestamptz(6)
  lastError              String?            @map("last_error")
  lastErrorAt            DateTime?          @map("last_error_at")
  maxDailyLoss           Float?             @map("max_daily_loss")
  maxTotalDrawdown       Float?             @map("max_total_drawdown")
  minProfitTarget        Float?             @map("min_profit_target")
  maxTradesPerDay        Int?               @map("max_trades_per_day")
  tradingDaysLeft        Int?               @map("trading_days_left")
  drawdownWarningPercent Float?             @default(80) @map("drawdown_warning_percent")
  profitWarningPercent   Float?             @default(90) @map("profit_warning_percent")
  tradesWarningThreshold Int?               @default(1) @map("trades_warning_threshold")
  daysWarningThreshold   Int?               @default(5) @map("days_warning_threshold")
  todayTradeCount        Int                @default(0) @map("today_trade_count")
  todayPnl               Float              @default(0) @map("today_pnl")
  lastStatsReset         DateTime?          @map("last_stats_reset") @db.Timestamptz(6)
  isActive               Boolean            @default(true) @map("is_active")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime?          @updatedAt @map("updated_at") @db.Timestamptz(6)
  journalTrades          JournalTrade[]
  signals                Signal[]
  trades                 Trade[]
  profile                Profile            @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@index([isActive])
  @@map("trading_accounts")
  @@schema("public")
}

model Signal {
  id          String          @id @default(uuid()) @db.Uuid
  accountId   String          @map("account_id") @db.Uuid
  symbol      String
  direction   SignalDirection
  status      SignalStatus
  entryPrice  Float           @map("entry_price")
  stopLoss    Float           @map("stop_loss")
  tp1         Float
  tp2         Float
  riskReward  Float           @map("risk_reward")
  riskPips    Float           @map("risk_pips")
  pattern     CandlePattern?
  wickRatio   Float?          @map("wick_ratio")
  rawJson     Json?           @map("raw_json")
  receivedAt  BigInt          @map("received_at")
  triggeredAt BigInt?         @map("triggered_at")
  outcome     String?
  tradeId     String?         @map("trade_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  account     TradingAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  trade       Trade?          @relation(fields: [tradeId], references: [id])

  @@index([accountId, symbol])
  @@index([accountId, status])
  @@index([receivedAt])
  @@map("signals")
  @@schema("public")
}

model Trade {
  id          String         @id @default(uuid()) @db.Uuid
  accountId   String         @map("account_id") @db.Uuid
  signalId    String         @map("signal_id") @db.Uuid
  symbol      String
  side        OrderSide
  status      TradeStatus    @default(OPEN)
  plan        Json
  entryTicket Int?           @map("entry_ticket")
  entryPrice  Float?         @map("entry_price")
  entryLots   Float          @map("entry_lots")
  currentLots Float          @map("current_lots")
  stopLoss    Float          @map("stop_loss")
  tp1         Float
  tp2         Float
  tp1Hit      Boolean        @default(false) @map("tp1_hit")
  tp1HitAt    DateTime?      @map("tp1_hit_at")
  tp2Hit      Boolean        @default(false) @map("tp2_hit")
  tp2HitAt    DateTime?      @map("tp2_hit_at")
  slHit       Boolean        @default(false) @map("sl_hit")
  slHitAt     DateTime?      @map("sl_hit_at")
  openedAt    DateTime?      @map("opened_at")
  closedAt    DateTime?      @map("closed_at")
  closeReason CloseReason?   @map("close_reason")
  closePrice  Float?         @map("close_price")
  realizedPnl Float?         @map("realized_pnl")
  realizedRR  Float?         @map("realized_rr")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  signals     Signal[]
  account     TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([openedAt])
  @@index([accountId, status])
  @@index([accountId, signalId])
  @@index([entryTicket])
  @@map("trades")
  @@schema("public")
}

model JournalTrade {
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  accountId       String                 @map("account_id") @db.Uuid
  strategyId      String                 @map("strategy_id") @db.Uuid
  symbol          String
  direction       TradeDirection
  status          JournalTradeStatus     @default(pending)
  result          JournalTradeResult?
  entryPrice      Float                  @map("entry_price")
  exitPrice       Float?                 @map("exit_price")
  quantity        Float
  ticketId        String?                @map("ticket_id")
  pnl             Float?
  pnlPercent      Float?                 @map("pnl_percent")
  commission      Float                  @default(0)
  swap            Float                  @default(0)
  followedPlan    Boolean?               @map("followed_plan")
  convictionLevel Conviction?            @map("conviction_level")
  emotionBefore   Emotion?               @map("emotion_before")
  emotionAfter    Emotion?               @map("emotion_after")
  notesBefore     String?                @map("notes_before")
  notesAfter      String?                @map("notes_after")
  screenshotUrls  String[]               @map("screenshot_urls")
  tradeDate       DateTime?              @map("trade_date")
  closedAt        DateTime?              @map("closed_at")
  source          String                 @default("manual")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?              @updatedAt @map("updated_at") @db.Timestamptz(6)
  profileUserId   String?                @db.Uuid
  checklistItems  JournalChecklistItem[]
  account         TradingAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  profile         Profile?               @relation(fields: [profileUserId], references: [userId])
  strategy        TradingStrategy        @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@map("journal_trades")
  @@schema("public")
}

model JournalChecklistItem {
  id            String       @id @default(uuid()) @db.Uuid
  tradeId       String       @map("trade_id") @db.Uuid
  checklistText String       @map("checklist_text")
  answeredYes   Boolean      @map("answered_yes")
  note          String?
  isAiGenerated Boolean      @default(true) @map("is_ai_generated")
  trade         JournalTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, checklistText])
  @@map("journal_checklist_items")
  @@schema("public")
}

model TradingStrategy {
  id                  String         @id @default(uuid()) @db.Uuid
  userId              String         @map("user_id") @db.Uuid
  name                String
  description         String
  tradingStyle        TradingStyle?  @map("trading_style")
  tradingHoursStart   String?        @default("09:00") @map("trading_hours_start")
  tradingHoursEnd     String?        @default("16:00") @map("trading_hours_end")
  sessionReminderMins Int?           @default(5) @map("session_reminder_mins")
  isDefault           Boolean        @default(false) @map("is_default")
  isArchived          Boolean        @default(false) @map("is_archived")
  aiRephrasedDesc     String?        @map("ai_rephrased_desc")
  aiNotes             String?        @map("ai_notes")
  aiParameters        Json?          @map("ai_parameters")
  aiReminderPhrases   Json?          @map("ai_reminder_phrases")
  aiRiskGuidelines    Json?          @map("ai_risk_guidelines")
  aiChecklistItems    Json?          @map("ai_checklist_items")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime?      @updatedAt @map("updated_at") @db.Timestamptz(6)
  journalTrades       JournalTrade[]
  profile             Profile        @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("trading_strategies")
  @@schema("public")
}

model SignalAlert {
  id                 String            @id @default(uuid()) @db.Uuid
  engineId           String            @unique @map("engine_id")
  symbol             String
  direction          SignalDirection
  status             SignalAlertStatus @default(PENDING)
  outcome            SignalOutcome?
  entryPrice         Float             @map("entry_price")
  stopLoss           Float             @map("stop_loss")
  tp1                Float
  tp2                Float
  riskRewardRatio    Float             @map("risk_reward_ratio")
  riskPips           Float             @map("risk_pips")
  htfRangeHigh       Float             @map("htf_range_high")
  htfRangeLow        Float             @map("htf_range_low")
  htfBosDirection    String            @map("htf_bos_direction")
  htfTimestamp       DateTime          @map("htf_timestamp")
  htfBrokenAt        DateTime?         @map("htf_broken_at")
  ltfRangeHigh       Float             @map("ltf_range_high")
  ltfRangeLow        Float             @map("ltf_range_low")
  ltfTimestamp       DateTime          @map("ltf_timestamp")
  ltfSlLevel         Float             @map("ltf_sl_level")
  rejectionOpen      Float             @map("rejection_open")
  rejectionHigh      Float             @map("rejection_high")
  rejectionLow       Float             @map("rejection_low")
  rejectionClose     Float             @map("rejection_close")
  rejectionTimestamp DateTime          @map("rejection_timestamp")
  rejectionWickRatio Float             @map("rejection_wick_ratio")
  rejectionPattern   String            @map("rejection_pattern")
  rejectionWickTip   Float             @map("rejection_wick_tip")
  rawPayload         Json              @map("raw_payload")
  realizedRr         Float?            @map("realized_rr")
  closePrice         Float?            @map("close_price")
  chartPath          String?           @map("chart_path")
  chartData          Json?             @map("chart_data")
  triggeredAt        DateTime?         @map("triggered_at")
  tp1HitAt           DateTime?         @map("tp1_hit_at")
  closedAt           DateTime?         @map("closed_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  zoneId             String?           @unique @map("zone_id") @db.Uuid
  htfInterval        String?           @map("htf_interval")
  ltfInterval        String?           @map("ltf_interval")
  notificationLogs   NotificationLog[]
  zone               SignalZone?       @relation(fields: [zoneId], references: [id])

  @@index([symbol])
  @@index([status])
  @@index([createdAt])
  @@map("signal_alerts")
  @@schema("public")
}

model SignalZone {
  id              String           @id @default(uuid()) @db.Uuid
  engineKey       String           @unique @map("engine_key")
  symbol          String
  direction       SignalDirection
  status          SignalZoneStatus @default(WATCHING)
  htfRangeHigh    Float            @map("htf_range_high")
  htfRangeLow     Float            @map("htf_range_low")
  htfBosDirection String           @map("htf_bos_direction")
  ltfRangeHigh    Float            @map("ltf_range_high")
  ltfRangeLow     Float            @map("ltf_range_low")
  ltfSlLevel      Float            @map("ltf_sl_level")
  rawPayload      Json             @map("raw_payload")
  pendingAt       DateTime         @map("pending_at")
  triggeredAt     DateTime?        @map("triggered_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  signalId        String?          @map("signal_id") @db.Uuid
  htfInterval     String?          @map("htf_interval")
  htfTimestamp    DateTime?        @map("htf_timestamp")
  htfTpLevel      Float?           @map("htf_tp_level")
  ltfInterval     String?          @map("ltf_interval")
  ltfTimestamp    DateTime?        @map("ltf_timestamp")
  signal          SignalAlert?

  @@index([symbol])
  @@index([status])
  @@index([createdAt])
  @@map("signal_zones")
  @@schema("public")
}

model UserSignalSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  symbol    String
  createdAt DateTime @default(now()) @map("created_at")
  profile   Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([symbol])
  @@map("user_signal_subscriptions")
  @@schema("public")
}

model NotificationLog {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  notificationType NotificationType @map("notification_type")
  accountId        String?          @map("account_id") @db.Uuid
  strategyId       String?          @map("strategy_id") @db.Uuid
  title            String
  body             String
  data             Json?
  sentAt           DateTime         @default(now()) @map("sent_at") @db.Timestamptz(6)
  delivered        Boolean          @default(false)
  opened           Boolean          @default(false)
  openedAt         DateTime?        @map("opened_at") @db.Timestamptz(6)
  signalAlertId    String?          @map("signal_alert_id") @db.Uuid
  signalAlert      SignalAlert?     @relation(fields: [signalAlertId], references: [id])
  profile          Profile          @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([notificationType, sentAt])
  @@map("notification_logs")
  @@schema("public")
}

model TradingAnalytics {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  tradingAccountId      String?   @map("trading_account_id") @db.Uuid
  performanceSummary    String    @map("performance_summary")
  strengths             String[]
  weaknesses            String[]
  tips                  String[]
  psychologicalInsights String[]  @map("psychological_insights")
  nextSteps             String[]  @map("next_steps")
  overallRiskLevel      RiskLevel @map("overall_risk_level")
  keyRisks              String[]  @map("key_risks")
  suggestedAdjustments  String[]  @map("suggested_adjustments")
  winRate               Float?    @map("win_rate")
  totalTrades           Int?      @map("total_trades")
  profitLoss            Float?    @map("profit_loss")
  aiModelVersion        String    @map("ai_model_version")
  dataRangeStart        DateTime? @map("data_range_start")
  dataRangeEnd          DateTime? @map("data_range_end")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  profile               Profile   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, tradingAccountId])
  @@index([userId])
  @@map("trading_analytics")
  @@schema("public")
}

model NewsArticle {
  id                  String   @id @default(cuid())
  source              String
  headline            String
  summary             String?
  url                 String?  @unique
  publishedAt         DateTime @map("published_at")
  isRelevant          Boolean  @default(true) @map("is_relevant")
  category            String?
  sentiment           String?
  symbols             String[] @default([])
  importance          String?
  tradingImplications String?  @map("trading_implications")
  affectedMarkets     String[] @default([]) @map("affected_markets")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([publishedAt])
  @@index([category])
  @@index([sentiment])
  @@map("news_articles")
  @@schema("public")
}

model SocialSentimentAggregate {
  id                Int      @id @default(autoincrement())
  symbol            String
  bullishScore      Int      @map("bullish_score")
  bearishScore      Int      @map("bearish_score")
  neutralScore      Int      @map("neutral_score")
  dominantSentiment String   @map("dominant_sentiment")
  postCount         Int      @default(0) @map("post_count")
  topicCloud        String[] @map("topic_cloud")
  summary           String   @default("")
  sampledAt         DateTime @map("sampled_at")

  @@unique([symbol, sampledAt])
  @@map("social_sentiment_aggregates")
  @@schema("public")
}

model QueueJob {
  id           String    @id @default(cuid())
  queueName    String    @map("queue_name")
  jobName      String    @map("job_name")
  jobData      String    @map("job_data")
  status       String    @default("pending")
  scheduledAt  DateTime  @default(now()) @map("scheduled_at")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3) @map("max_attempts")
  backoffType  String    @default("exponential") @map("backoff_type")
  backoffDelay Int       @default(2000) @map("backoff_delay")
  priority     Int       @default(0)
  error        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([queueName, status, scheduledAt])
  @@index([status, scheduledAt])
  @@map("queue_jobs")
  @@schema("public")
}

model MetricsCounter {
  name      String @id
  value     BigInt @default(0)
  updatedAt BigInt @map("updated_at")

  @@map("metrics_counters")
  @@schema("public")
}

model MetricsGauge {
  name      String @id
  value     Float  @default(0)
  updatedAt BigInt @map("updated_at")

  @@map("metrics_gauges")
  @@schema("public")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model ReferralLink {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  referralCode      String   @unique @map("referral_code") @db.VarChar(12)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  influencer_tier   String   @default("starter") @db.VarChar(20)
  total_clicks      Int      @default(0)
  unique_clicks     Int      @default(0)
  payout_preference String   @default("subscription") @db.VarChar(20)
  custom_slug       String?  @db.VarChar(50)
  profile           Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("referral_links")
  @@schema("public")
}

model Referral {
  id                        String           @id @default(uuid()) @db.Uuid
  referrerId                String           @map("referrer_id") @db.Uuid
  refereeId                 String?          @map("referee_id") @db.Uuid
  referralCode              String           @map("referral_code") @db.VarChar(12)
  status                    ReferralStatus   @default(pending)
  signedUpAt                DateTime?        @map("signed_up_at") @db.Timestamptz(6)
  subscribedAt              DateTime?        @map("subscribed_at") @db.Timestamptz(6)
  referrerReward            String?          @map("referrer_reward") @db.VarChar(50)
  refereeReward             String?          @map("referee_reward") @db.VarChar(50)
  referrerRewardAmount      Decimal?         @map("referrer_reward_amount") @db.Decimal(10, 2)
  refereeRewardAmount       Decimal?         @map("referee_reward_amount") @db.Decimal(10, 2)
  referrerRewardClaimed     Boolean          @default(false) @map("referrer_reward_claimed")
  referrerRewardClaimedAt   DateTime?        @map("referrer_reward_claimed_at") @db.Timestamptz(6)
  refereeRewardClaimed      Boolean          @default(false) @map("referee_reward_claimed")
  refereeRewardClaimedAt    DateTime?        @map("referee_reward_claimed_at") @db.Timestamptz(6)
  utmSource                 String?          @map("utm_source") @db.VarChar(100)
  utmMedium                 String?          @map("utm_medium") @db.VarChar(100)
  ipAddress                 String?          @map("ip_address") @db.VarChar(50)
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  refereeSubscriptionPrice  Decimal?         @map("referee_subscription_price") @db.Decimal(10, 2)
  refereeTierAtSubscription String?          @map("referee_tier_at_subscription") @db.VarChar(20)
  referee_bonus_days        Int              @default(0)
  referee_bonus_applied     Boolean          @default(false)
  rewards                   ReferralReward[]
  referee                   Profile?         @relation("RefereeReferrals", fields: [refereeId], references: [userId])
  referrer                  Profile          @relation("ReferrerReferrals", fields: [referrerId], references: [userId], onDelete: Cascade)

  @@index([referrerId, status])
  @@index([refereeId])
  @@index([referralCode])
  @@index([createdAt])
  @@map("referrals")
  @@schema("public")
}

model ReferralReward {
  id                   String    @id @default(uuid()) @db.Uuid
  referralId           String    @map("referral_id") @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  rewardType           String    @map("reward_type") @db.VarChar(50)
  amount               Decimal   @default(0) @map("amount") @db.Decimal(10, 2)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt               DateTime? @map("used_at") @db.Timestamptz(6)
  usedWithSubscription String?   @map("used_with_subscription") @db.VarChar(50)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  appliedToUserId      String?   @map("applied_to_user_id") @db.Uuid
  claimedAt            DateTime? @map("claimed_at") @db.Timestamptz(6)
  monthsAwarded        Int       @default(1) @map("months_awarded")
  newExpiryDate        DateTime? @map("new_expiry_date") @db.Timestamptz(6)
  status               String    @default("pending") @map("status") @db.VarChar(20)
  tierAwarded          String?   @map("tier_awarded") @db.VarChar(20)
  tierValue            Decimal?  @map("tier_value") @db.Decimal(10, 2)
  reward_subtype       String?   @db.VarChar(30)
  credit_amount        Decimal?  @db.Decimal(10, 2)
  referral             Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)
  profile              Profile   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, expiresAt])
  @@map("referral_rewards")
  @@schema("public")
}

