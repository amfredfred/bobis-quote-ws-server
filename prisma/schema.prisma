  referral_code String   @db.VarChar(50)
  ip_hash       String?  @db.VarChar(64)
  ua_hash       String?  @db.VarChar(64)
  country_code  String?  @db.Char(2)
  is_unique     Boolean  @default(false)
  clicked_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([referral_code, clicked_at(sort: Desc)], map: "rlc_code_time_idx")
  @@index([ip_hash, referral_code], map: "rlc_ip_code_idx")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model referral_milestone_events {
